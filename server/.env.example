# Server Port
PORT=5000

# Environment ("development" or "production")
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/GoatLeads?retryWrites=true&w=majority

# Comma-separated allowed frontend origins (no trailing slash)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Strong random secret for signing JWTs (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# First admin email auto-bootstrapped on initial login/register
ADMIN_EMAIL=admin@yourdomain.com

# SMTP Settings (required in production for team invites & task reminder emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@yourdomain.com
SMTP_PASS=your-app-password
EMAIL_FROM="GoatLeads CRM <no-reply@yourdomain.com>"

# Optional: Authenticated ExchangeRate-API key (falls back to open.er-api.com if blank)
EXCHANGE_RATE_API_KEY=

# Optional: Gemini API key for AI Copilot email/call script drafting
GEMINI_API_KEY=

